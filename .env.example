# ─── Frontend (Vite — prefixed VITE_*, exposed to the browser) ───────
# These are safe to ship in the bundle; they're the ANON keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Optional — used only by analytics scripts. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# ─── Sentry (production error monitoring — optional) ─────────────────
# Leave DSN empty to disable Sentry entirely (true no-op, no network calls).
# When enabled, the client reports unhandled errors and a 10% trace sample.
# Get a DSN from https://sentry.io → your-project → Settings → Client Keys.
VITE_SENTRY_DSN=
# Override defaults if you want tighter/looser sampling (floats, 0..1).
# VITE_SENTRY_TRACES_RATE=0.1
# VITE_SENTRY_REPLAY_ON_ERROR_RATE=0.1
# Set to the commit SHA at build time so Sentry groups errors by release.
# VITE_APP_VERSION=

# ─── Supabase Edge Function secrets (set via Supabase dashboard) ─────
# NEVER commit real values. Listed here for the on-call reference.
#
# SUPABASE_URL                  — auto-injected
# SUPABASE_ANON_KEY             — auto-injected
# SUPABASE_SERVICE_ROLE_KEY     — auto-injected (server-side only)
# RESEND_API_KEY                — re_...  (transactional email)
# EMAIL_FROM                    — e.g. "SINA <noreply@cidoma.com>" (verified domain)
# ADMIN_EMAIL                   — fallback recipient for platform alerts
# OPENAI_API_KEY                — sk-...  (seo-generate, analyze-developer)
# PUBLIC_SITE_URL               — https://cidoma.com
# ALLOWED_ROOT_DOMAIN           — cidoma.com  (CORS allowlist)
# INDEXNOW_KEY                  — random 32-char key mirrored at public/<key>.txt

# ─── Local-dev only ──────────────────────────────────────────────────
# If you run `supabase start` locally, Vite picks up these fallbacks.
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<from `supabase status`>
